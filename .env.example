# API key for optional IOC enrichment (--enrich flag).
# Copy this file to .env — the tool reads it automatically from the working
# directory when it starts, so no need to source it manually.

# AbuseIPDB — https://www.abuseipdb.com/account/api
# Usage: ioc-extractor report.txt --enrich
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
