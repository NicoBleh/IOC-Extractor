# API keys for optional IOC enrichment (--enrich flag).
# Copy this file to .env, fill in your keys, then load it before running:
#   source .env
#
# Neither key is required for the core extraction to work.

# AbuseIPDB — https://www.abuseipdb.com/account/api
# Used with: ioc-extractor report.txt --enrich abuseipdb
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# VirusTotal — https://www.virustotal.com/gui/my-apikey
# Used with: ioc-extractor report.txt --enrich virustotal
VT_API_KEY=your_virustotal_key_here
